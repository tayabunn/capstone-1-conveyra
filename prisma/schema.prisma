generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String?
  avatarUrl       String?
  defaultTone     String         @default("professional")
  defaultChannel  String         @default("email")
  defaultLength   String         @default("medium")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  calibrations    Calibration[]
  personas        Persona[]
  playbooks       PlaybookItem[]

  @@map("users")
}

model Calibration {
  id              String         @id @default(uuid())
  userId          String
  rawInput        String         @db.Text
  recipient       String
  objective       String
  channel         String
  tone            String
  
  subject         String?
  calibratedText  String         @db.Text
  rationale       String         @db.Text
  alternativeText String?        @db.Text
  riskAvoided     String?
  
  isFavorite      Boolean        @default(false)
  tags            String[]       @default([])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isFavorite])
  @@map("calibrations")
}

model Persona {
  id              String         @id @default(uuid())
  userId          String
  title           String
  description     String?
  preferredTone   String         @default("diplomatic")
  sensitivities   String[]       @default([])
  createdAt       DateTime       @default(now())

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personas")
}

model PlaybookItem {
  id              String         @id @default(uuid())
  userId          String
  title           String
  category        String
  templateText    String         @db.Text
  contextNotes    String?
  createdAt       DateTime       @default(now())

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@map("playbook_items")
}
