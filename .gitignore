# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.*

# testing
/coverage/
**/coverage/
/playwright-report/
/test-results/

# next.js
/.next/
**/.next/
/out/

# production
/build
/dist

# local state and storage
.data/
**/.data/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets must never be committed)
.env
.env.local
.env*.local
backend/.env
frontend/.env.local
frontend/.env

# typescript
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts
